<!-- @format -->

<!-- @modal -->

<div
    class="modal fade"
    id="booksModal-<%= id %>"
    tabindex="-1"
    aria-labelledby="booksModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: blanchedalmond;">
            <div class="modal-header">
                <h5 class="modal-title" id="bookInformation">Book Information</h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>
            </div>
            <div class="modal-body">
                <p id="books-genre">Genre: <%= books.bookGenre %></p>
                <p id="books-price">Price: $<%= books.bookPrice %></p>
            </div>
            <div class="modal-footer">
                <button 
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
                >
                Close
                </button>
            </div>
        </div>
    </div>
</div>